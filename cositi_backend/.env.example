# --- Serveur ---
NODE_ENV=development
PORT=4000
# Origines autorisées (CORS), séparées par des virgules. Le front Vite tourne sur le port 3000.
CORS_ORIGINS=http://localhost:3000
# Derrière un reverse proxy (nginx, Cloud Run...) : nombre de proxys de confiance (0 = aucun)
TRUST_PROXY=0

# --- Base de données MySQL (8.x / MariaDB 10.5+) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cositi
DB_PASSWORD=
DB_NAME=cositi_ci
DB_POOL_SIZE=10
# Crée la base au démarrage si elle n'existe pas (privilège CREATE requis pour DB_USER)
DB_AUTO_CREATE=true
# Hôte depuis lequel DB_USER se connecte, utilisé quand l'utilisateur est créé ('cositi'@'localhost')
DB_USER_HOST=localhost
# Compte administrateur MySQL qui crée la base, l'utilisateur ci-dessus et ses privilèges (seulement ce qui manque).
# Utilisé par « npm run db:setup » ; au démarrage de l'API UNIQUEMENT si DB_PROVISION_ON_START=true.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=
# true : si DB_USER est refusé ou manque de privilèges, l'API utilise DB_ADMIN_USER pour créer ce qui manque (désactivé par défaut)
DB_PROVISION_ON_START=false

# --- Authentification ---
# OBLIGATOIRE en production : chaînes aléatoires longues (ex: openssl rand -hex 48)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
# Verrouillage de compte après N échecs consécutifs, pour M minutes
MAX_LOGIN_ATTEMPTS=5
LOCK_MINUTES=15

# --- Codes de sécurité ---
# Code de maintenance (mise à jour logicielle / effacement des données)
MAINTENANCE_CODE=1111
# Autorise POST /api/systeme/reset-demo (recharge le dump, efface les données actuelles). Désactivé par défaut en production.
ALLOW_DEMO_RESET=true

# --- Premier démarrage (base VIDE) ---
# true  : importe les données de database_mysql/cositi_database_mysql_dump.sql et crée les identifiants de connexion
# false : crée uniquement les paramètres par défaut (+ le Super Administrateur ci-dessous)
SEED_FROM_DUMP=true
# Fichier SQL importé (par défaut : ../database_mysql/cositi_database_mysql_dump.sql)
DUMP_PATH=
# Identifiants initiaux des comptes importés (stockés HACHÉS en base) : mot de passe
SEED_DEFAULT_PASSWORD=Cositi@2026!
# true : changement de mot de passe obligatoire à la 1re connexion (recommandé en production)
SEED_FORCE_PASSWORD_CHANGE=false

# --- Super Administrateur (créé au démarrage s'il n'en existe aucun) ---
# Seul rôle habilité à créer des comptes et à modifier les informations de connexion des acteurs.
SUPERADMIN_NOM=Super Administrateur COSITI
SUPERADMIN_EMAIL=superadmin@cositi-ci.org
# Vide en production => mot de passe aléatoire affiché une fois dans la console (changement imposé)
SUPERADMIN_PASSWORD=SuperAdmin@2026!
