{
  "name": "cositi-backend",
  "version": "2.0.0",
  "description": "API REST COSITI (MySQL) — adhérents, cotisations, dossiers CNPS, finances DAF, paie, direction, audit, Swagger",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:setup": "node scripts/db-setup.js",
    "db:seed": "node src/db/seed-cli.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "docs:check": "node scripts/docs-check.js",
    "docs:roles": "node scripts/gen-roles-doc.js",
    "docs:front": "node scripts/front-coverage.js",
    "docs:all": "npm run docs:check && npm run docs:roles && npm run docs:front",
    "test:e2e": "node tests/e2e/navigateur.e2e.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.22.3",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "swagger-ui-express": "^5.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "puppeteer-core": "^24.0.0"
  }
}
